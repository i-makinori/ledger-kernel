;;; 00-classical-fol-equality.system
;;;
;;; Classical first-order logic with equality, as data: term?/wff?
;;; formation rules, the inference rules MP, Gen, IOTA and EXISTS-ELIM, and
;;; axioms II.1-3 (propositional), III.1-3 (quantifiers), IV.1-4 (equality).
;;; This file is the only place this logic is defined; load it with
;;; BOOTSTRAP-KERNEL-FROM-SPEC-FILE. Every entry here is :PRIMITIVE --
;;; trusted, never checked -- so loading it is an act of trust in its text.
;;;
;;; There is no generic "(wff? ?A)" or "(var? ?x)" rule: it would accept
;;; any symbol. Declared atomic symbols and variables are recognized by
;;; the kernel directly (DECLARED-SYMBOL-JUDGEMENT-P in judgement.lisp).

;;; --- term?/wff? formation ------------------------------------------

(:term-formation var-term ((var? ?x)) (term? ?x))
;; (.iota x A): "the x such that A" -- a TERM-producing binder. Inert on
;; its own; all of its meaning comes from the IOTA irule below.
(:term-formation iota-term ((var? ?x) (wff? ?A)) (term? (.iota ?x ?A)))

(:wff-formation wff_to? ((wff? ?A) (wff? ?B)) (wff? (.to ?A ?B)))
(:wff-formation wff_neg? ((wff? ?A)) (wff? (.neg ?A)))
(:wff-formation wff_forall? ((var? ?x) (wff? ?A)) (wff? (.forall ?x ?A)))
;; .EXISTS's syntax; III.3 and EXISTS-ELIM below give it its meaning.
(:wff-formation wff_exists? ((var? ?x) (wff? ?A)) (wff? (.exists ?x ?A)))
(:wff-formation wff_eq? ((term? ?s) (term? ?t)) (wff? (.eq ?s ?t)))

;;; --- inference rules --------------------------------------------------

(:irule MP ((wff? ?A) (wff? ?B)) (((.to ?A ?B) ?A) nil :=> ?B))
(:irule Gen ((var? ?x) (wff? ?A) (@not-free-in-dependencies? ?x))
        ((?A) (?x) :=> (.forall ?x ?A)))
;; IOTA: from EXISTENCE (.exists ?x ?A) and UNIQUENESS "any two things
;; satisfying A are equal", concludes A[(.iota ?x ?A)/?x]. An irule, not
;; an axiom: existence and uniqueness are facts about a particular A and
;; must be proved lines of the current proof. Premises are matched left
;; to right, so ?x/?A are bound by the first before the second's @subst
;; forms are evaluated.
(:irule IOTA ((var? ?x) (wff? ?A) (@subst-ok? ?x (.iota ?x ?A) ?A))
        (((.exists ?x ?A)
          (.forall ?y (.forall ?z (.to (@subst ?x ?y ?A)
                                       (.to (@subst ?x ?z ?A) (.eq ?y ?z))))))
         nil :=>
         (@subst ?x (.iota ?x ?A) ?A)))
;; EXISTS-ELIM: genuine existential elimination (Mendelson's Rule C).
;; ?Ac is bound PURELY STRUCTURALLY (not via an embedded @subst -- ?w
;; isn't ground yet at premise-matching time) and then verified, as a
;; side condition, to equal A[w/x] via @substitutes?. Named ?w, not ?c:
;; a pattern variable ?c and ?C would be THE SAME SYMBOL once read (the
;; reader case-normalizes to upper case).
(:irule EXISTS-ELIM ((var? ?x) (var? ?w) (wff? ?A) (wff? ?Ac) (wff? ?C)
                      (@substitutes? ?x ?w ?A ?Ac)
                      (@subst-ok? ?x ?w ?A)
                      (@not-free-in? ?w ?A)
                      (@not-free-in? ?w ?C)
                      (@not-free-in-dependencies? ?w))
        (((.exists ?x ?A) (.to ?Ac ?C))
         (?w) :=>
         ?C))

;;; --- II.1-3: classical propositional logic -----------------------------
;;;   II.1  A -> (B -> A)                                     [K]
;;;   II.2  (A -> (B -> C)) -> ((A -> B) -> (A -> C))          [S]
;;;   II.3  (.neg B -> .neg A) -> (A -> B)                     [contraposition]
;;; Lukasiewicz's complete basis. II.2 (S) is what makes the Deduction
;;; Theorem provable at all: {K, B, C} is not enough. The case split
;;; (A -> C) -> ((.neg A -> C) -> C), once admitted here as axiom II.4, is
;;; now the theorem TH-CASE-SPLIT of 05-classical-logic.ledger, derived
;;; from II.1-3; the name II.4 is no longer an axiom.

(:axiom II.1 ((wff? ?A) (wff? ?B)) (nil (.to ?A (.to ?B ?A))))
(:axiom II.2 ((wff? ?A) (wff? ?B) (wff? ?C))
        (nil (.to (.to ?A (.to ?B ?C)) (.to (.to ?A ?B) (.to ?A ?C)))))
(:axiom II.3 ((wff? ?A) (wff? ?B)) (nil (.to (.to (.neg ?B) (.neg ?A)) (.to ?A ?B))))

;;; --- III.1-2: predicate logic -------------------------------------------

(:axiom III.1 ((var? ?x) (wff? ?A) (term? ?t) (@subst-ok? ?x ?t ?A))
        ((?t) (.to (.forall ?x ?A) (@subst ?x ?t ?A))))
(:axiom III.2 ((var? ?x) (wff? ?A) (wff? ?B) (@not-free-in? ?x ?A))
        (nil (.to (.forall ?x (.to ?A ?B)) (.to ?A (.forall ?x ?B)))))
;; III.3: existential generalization, A[t/x] -> exists x. A. Extra
;; params are (?x ?A ?t), NOT just (?t) like III.1 -- the binder here
;; sits in the CONSEQUENT while @subst sits in the ANTECEDENT, so ?x/?A
;; cannot be left to bind structurally before @subst is reached (matching
;; is left to right).
(:axiom III.3 ((var? ?x) (wff? ?A) (term? ?t) (@subst-ok? ?x ?t ?A))
        ((?x ?A ?t) (.to (@subst ?x ?t ?A) (.exists ?x ?A))))

;;; --- IV.1-4: first-order equality ---------------------------------------

(:axiom IV.1 ((term? ?t)) (nil (.eq ?t ?t)))
(:axiom IV.2 ((var? ?x) (wff? ?A) (term? ?t) (@subst-ok? ?x ?t ?A))
        (nil (.to (.eq ?x ?t) (.to ?A (@subst ?x ?t ?A)))))
(:axiom IV.3 ((term? ?s) (term? ?t)) (nil (.to (.eq ?s ?t) (.eq ?t ?s))))
(:axiom IV.4 ((term? ?s) (term? ?t) (term? ?u))
        (nil (.to (.eq ?s ?t) (.to (.eq ?t ?u) (.eq ?s ?u)))))
