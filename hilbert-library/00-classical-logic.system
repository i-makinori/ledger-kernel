;;; 00-classical-logic.system
;;;
;;; Classical first-order logic, loaded ON TOP OF 00-fol-language.system:
;;; the inference rules MP and Gen, the Deduction Theorem as a declared
;;; meta-theorem, and axioms II.1-3 (propositional) and III.1-2
;;; (quantifiers). The existential quantifier is an abbreviation, as in
;;; Mendelson: exists x A := not forall x not A -- a classical reading, so
;;; it belongs to this logic rather than to the language. Existential
;;; generalization and existential elimination (Rule C) are therefore not
;;; primitive: they are the theorems TH-EXISTS-INTRO and TH-EXISTS-ELIM of
;;; 05-classical-logic.ledger.

;;; --- abbreviations -------------------------------------------------

(:abbreviation (.exists ?x ?A) (.neg (.forall ?x (.neg ?A))))

;;; --- inference rules --------------------------------------------------

(:irule MP ((wff? ?A) (wff? ?B)) (((.to ?A ?B) ?A) nil :=> ?B))
(:irule Gen ((var? ?x) (wff? ?A) (@not-free-in-dependencies? ?x))
        ((?A) (?x) :=> (.forall ?x ?A)))

;;; --- the Deduction Theorem, as a meta-theorem of this logic -------------
;;;
;;; (@vdash ?H ?A): line ?A of a proof, depending on the hypothesis ?H
;;; that is being discharged, becomes Gamma |- ?H -> ?A. One case per way
;;; a line can arise; a TH-DED entry is admitted only if every line of its
;;; proof is covered (meta-theorem.lisp, deduction.lisp). Each case is the
;;; textbook induction step for that rule; its (:proof ...) template is
;;; that step written out as a proof, so a TH-DED is also built as a real
;;; proof of Gamma |- H -> PHI and checked:
;;;   :assumption  H -> H                           from II.1, II.2
;;;   :independent A |- H -> A                      from II.1
;;;   MP           H -> (A -> B), H -> A |- H -> B  from II.2
;;;   Gen          H -> A |- H -> forall x A, x not free in H   from III.2
;;; Gen needs its variable not free in H; without that condition
;;; P(x) |- forall x P(x) would give |- P(x) -> forall x P(x).
;;; A file that adds an inference rule may add its case
;;; (00-description.system does, for IOTA).

(:meta-theorem deduction
  (:discharge (@vdash ?H ?A) (.to ?H ?A))
  (:case :assumption ((wff? ?H)) (nil nil :=> (@vdash ?H ?H))
         (:proof ((1 (.to ?H (.to (.to ?H ?H) ?H)) :axiom (II.1))
                  (2 (.to (.to ?H (.to (.to ?H ?H) ?H)) (.to (.to ?H (.to ?H ?H)) (.to ?H ?H)))
                     :axiom (II.2))
                  (3 (.to (.to ?H (.to ?H ?H)) (.to ?H ?H)) :ir (MP 2 1))
                  (4 (.to ?H (.to ?H ?H)) :axiom (II.1))
                  (5 (.to ?H ?H) :ir (MP 3 4)))))
  (:case :independent ((wff? ?H) (wff? ?A)) (nil nil :=> (@vdash ?H ?A))
         (:proof ((1 (.to ?A (.to ?H ?A)) :axiom (II.1))
                  (2 (.to ?H ?A) :ir (MP 1 :line)))))
  (:case MP ((wff? ?H) (wff? ?A) (wff? ?B))
         (((@vdash ?H (.to ?A ?B)) (@vdash ?H ?A)) nil :=> (@vdash ?H ?B))
         (:proof ((1 (.to (.to ?H (.to ?A ?B)) (.to (.to ?H ?A) (.to ?H ?B))) :axiom (II.2))
                  (2 (.to (.to ?H ?A) (.to ?H ?B)) :ir (MP 1 :premise-0))
                  (3 (.to ?H ?B) :ir (MP 2 :premise-1)))))
  (:case Gen ((wff? ?H) (var? ?x) (wff? ?A) (@not-free-in? ?x ?H))
         (((@vdash ?H ?A)) (?x) :=> (@vdash ?H (.forall ?x ?A)))
         (:proof ((1 (.forall ?x (.to ?H ?A)) :ir (Gen :premise-0 ?x))
                  (2 (.to (.forall ?x (.to ?H ?A)) (.to ?H (.forall ?x ?A))) :axiom (III.2))
                  (3 (.to ?H (.forall ?x ?A)) :ir (MP 2 1))))))

;;; --- II.1-3: classical propositional logic -----------------------------
;;;   II.1  A -> (B -> A)                                     [K]
;;;   II.2  (A -> (B -> C)) -> ((A -> B) -> (A -> C))          [S]
;;;   II.3  (.neg B -> .neg A) -> (A -> B)                     [contraposition]
;;; Lukasiewicz's complete basis. II.2 (S) is what makes the Deduction
;;; Theorem provable at all: {K, B, C} is not enough. The case split
;;; (A -> C) -> ((.neg A -> C) -> C), once admitted here as axiom II.4, is
;;; now the theorem TH-CASE-SPLIT of 05-classical-logic.ledger, derived
;;; from II.1-3; the name II.4 is no longer an axiom.

(:axiom II.1 ((wff? ?A) (wff? ?B)) (nil (.to ?A (.to ?B ?A))))
(:axiom II.2 ((wff? ?A) (wff? ?B) (wff? ?C))
        (nil (.to (.to ?A (.to ?B ?C)) (.to (.to ?A ?B) (.to ?A ?C)))))
(:axiom II.3 ((wff? ?A) (wff? ?B)) (nil (.to (.to (.neg ?B) (.neg ?A)) (.to ?A ?B))))

;;; --- III.1-2: predicate logic -------------------------------------------
;;; (III.3, existential generalization, is the theorem TH-EXISTS-INTRO.)

(:axiom III.1 ((var? ?x) (wff? ?A) (term? ?t) (@subst-ok? ?x ?t ?A))
        ((?t) (.to (.forall ?x ?A) (@subst ?x ?t ?A))))
(:axiom III.2 ((var? ?x) (wff? ?A) (wff? ?B) (@not-free-in? ?x ?A))
        (nil (.to (.forall ?x (.to ?A ?B)) (.to ?A (.forall ?x ?B)))))
