;;; 00-connectives.system
;;;
;;; Defined connectives: conjunction, disjunction, biconditional and the
;;; unique-existence quantifier, as a SYSTEM-SPEC add-on file (see
;;; src/system-spec.lisp). Load it ON TOP OF
;;; 00-classical-fol-equality.system:
;;;
;;;   (bootstrap-kernel-from-spec-file
;;;     "hilbert-library/00-connectives.system"
;;;     :ledger (bootstrap-kernel-from-spec-file
;;;               "hilbert-library/00-classical-fol-equality.system"))
;;;
;;; Each connective is an ABBREVIATION (src/abbreviation.lisp): it adds no
;;; formation rule and no axiom. Written input is expanded into the
;;; primitive language before the kernel sees it, so (.and A B) and
;;; (.neg (.to A (.neg B))) are the same formula, and nothing is trusted
;;; here beyond what 00-classical-fol-equality.system already is.
;;;
;;;   (.and A B)     A ∧ B    :=  (.neg (.to A (.neg B)))
;;;   (.or A B)      A ∨ B    :=  (.to (.neg A) B)
;;;   (.iff A B)     A ↔ B    :=  (.and (.to A B) (.to B A))
;;;   (.exists1 x A) ∃!x A    :=  (.exists x (.and A (.forall u (.to A[u/x] (.eq u x)))))
;;;
;;; In .exists1, ?x is the variable written after .exists1 and binds as
;;; the body says; ?u is renamed to a fresh variable at each expansion, so
;;; it can neither clash with x nor capture anything in A.
;;;
;;; The description (.iota x A), "the x such that A", is an incomplete
;;; symbol as in Principia *14.01: not a term, but a way of writing a
;;; formula. An atomic formula psi holding it, at the narrowest scope,
;;; stands for
;;;   exists b ((forall x (A <-> x = b)) and psi[b/(.iota x A)])
;;; (src/abbreviation.lisp). With existence and uniqueness proved, which
;;; formula the scope is taken in does not matter (*14.3).

(:abbreviation (.and ?A ?B) (.neg (.to ?A (.neg ?B))))
(:abbreviation (.or ?A ?B) (.to (.neg ?A) ?B))
(:abbreviation (.iff ?A ?B) (.and (.to ?A ?B) (.to ?B ?A)))
(:abbreviation (.exists1 ?x ?A)
               (.exists ?x (.and ?A (.forall ?u (.to (@subst ?x ?u ?A) (.eq ?u ?x))))))
(:contextual-abbreviation (.iota ?x ?A) (?psi ?b)
  (.exists ?b (.and (.forall ?x (.iff ?A (.eq ?x ?b))) (?psi ?b))))
