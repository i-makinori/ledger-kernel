;;; 00-peano-arithmetic.system
;;;
;;; Peano arithmetic, loaded ON TOP OF 00-classical-fol-equality.system
;;; (BOOTSTRAP-KERNEL-FROM-SPEC-FILE with :LEDGER): term formation for
;;; ZERO, S, +, * and axioms P1-P10. Every entry is :PRIMITIVE (trusted).
;;;
;;;   P1-P2   successor is injective and never zero
;;;   P3      induction, curried: A[0/x] -> (forall x (A -> A[Sx/x])) ->
;;;           forall x A. Cited as (P3 x A): ?x and ?A must be supplied as
;;;           extra arguments because the conclusion begins with
;;;           (@subst ?x zero ?A), which can only be evaluated once both
;;;           are bound.
;;;   P4-P7   the recursive equations of + and *, stated as axioms (there
;;;           is no primitive recursion other than proof)
;;;   P8-P10  congruence of S, +, * under equality. IV.2 cannot give these:
;;;           it substitutes every free occurrence of a variable at once,
;;;           while congruence needs one copy of x changed and one kept.

;;; --- term formation: ZERO, S, +, * --------------------------------------

(:term-formation zero-term nil (term? zero))
(:term-formation succ-term ((term? ?x)) (term? (S ?x)))
(:term-formation plus-term ((term? ?x) (term? ?y)) (term? (+ ?x ?y)))
(:term-formation times-term ((term? ?x) (term? ?y)) (term? (* ?x ?y)))

;;; --- P1-P10 --------------------------------------------------------------

(:axiom P1 ((term? ?x)) (nil (.neg (.eq (S ?x) zero))))
(:axiom P2 ((term? ?x) (term? ?y)) (nil (.to (.eq (S ?x) (S ?y)) (.eq ?x ?y))))
(:axiom P3 ((var? ?x) (wff? ?A) (term? zero) (term? (S ?x))
            (@subst-ok? ?x zero ?A) (@subst-ok? ?x (S ?x) ?A))
        ((?x ?A)
         (.to (@subst ?x zero ?A)
              (.to (.forall ?x (.to ?A (@subst ?x (S ?x) ?A)))
                   (.forall ?x ?A)))))
(:axiom P4 ((term? ?x)) (nil (.eq (+ ?x zero) ?x)))
(:axiom P5 ((term? ?x) (term? ?y)) (nil (.eq (+ ?x (S ?y)) (S (+ ?x ?y)))))
(:axiom P6 ((term? ?x)) (nil (.eq (* ?x zero) zero)))
(:axiom P7 ((term? ?x) (term? ?y)) (nil (.eq (* ?x (S ?y)) (+ (* ?x ?y) ?x))))
(:axiom P8 ((term? ?x) (term? ?y)) (nil (.to (.eq ?x ?y) (.eq (S ?x) (S ?y)))))
(:axiom P9 ((term? ?x1) (term? ?y1) (term? ?x2) (term? ?y2))
        (nil (.to (.eq ?x1 ?y1) (.to (.eq ?x2 ?y2) (.eq (+ ?x1 ?x2) (+ ?y1 ?y2))))))
(:axiom P10 ((term? ?x1) (term? ?y1) (term? ?x2) (term? ?y2))
        (nil (.to (.eq ?x1 ?y1) (.to (.eq ?x2 ?y2) (.eq (* ?x1 ?x2) (* ?y1 ?y2))))))
