;;; 00-peano-order.system
;;;
;;; The order of the natural numbers as abbreviations over Peano
;;; arithmetic (src/abbreviation.lisp). Load ON TOP OF
;;; 00-peano-arithmetic.system.
;;;
;;;   (.le s t)   s <= t   :=  (.exists z (.eq (+ s z) t))
;;;   (.lt s t)   s < t    :=  (.le (S s) t)
;;;
;;; As with 00-connectives.system, nothing here is an axiom: (.le s t) is
;;; expanded before the kernel sees it. The bound z is renamed to a fresh
;;; variable at each expansion, so it is never free in s or t.

(:abbreviation (.le ?s ?t) (.exists ?z (.eq (+ ?s ?z) ?t)))
(:abbreviation (.lt ?s ?t) (.le (S ?s) ?t))
