(:th-ded th-ex-falso (.neg a)
 ((0 (.neg a) :hyp nil)
  (1 (.to (.neg a) (.to (.neg b) (.neg a))) :axiom (ii.1))
  (2 (.to (.neg b) (.neg a)) :ir (mp 1 0))
  (3 (.to (.to (.neg b) (.neg a)) (.to a b)) :axiom (ii.3))
  (4 (.to a b) :ir (mp 3 2))))
(:th-ded th-dneg-elim (.neg (.neg a))
 ((0 (.neg (.neg a)) :hyp nil)
  (1 (.to (.neg (.neg a)) (.to (.neg (.neg (.neg (.neg a)))) (.neg (.neg a)))) :axiom (ii.1))
  (2 (.to (.neg (.neg (.neg (.neg a)))) (.neg (.neg a))) :ir (mp 1 0))
  (3 (.to (.to (.neg (.neg (.neg (.neg a)))) (.neg (.neg a))) (.to (.neg a) (.neg (.neg (.neg a))))) :axiom (ii.3))
  (4 (.to (.neg a) (.neg (.neg (.neg a)))) :ir (mp 3 2))
  (5 (.to (.to (.neg a) (.neg (.neg (.neg a)))) (.to (.neg (.neg a)) a)) :axiom (ii.3))
  (6 (.to (.neg (.neg a)) a) :ir (mp 5 4))
  (7 a :ir (mp 6 0))))
(:th th-dneg-intro
 ((0 (.to (.neg (.neg (.neg a))) (.neg a)) :th-ded (th-dneg-elim))
  (1 (.to (.to (.neg (.neg (.neg a))) (.neg a)) (.to a (.neg (.neg a)))) :axiom (ii.3))
  (2 (.to a (.neg (.neg a))) :ir (mp 1 0))))
(:th-ded th-mt-step1 (.neg (.neg a))
 ((0 (.to a b) :hyp nil)
  (1 (.neg (.neg a)) :hyp nil)
  (2 (.to (.neg (.neg a)) a) :th-ded (th-dneg-elim))
  (3 a :ir (mp 2 1))
  (4 b :ir (mp 0 3))
  (5 (.to b (.neg (.neg b))) :th (th-dneg-intro))
  (6 (.neg (.neg b)) :ir (mp 5 4))))
(:th-ded th-modus-tollens (.to a b)
 ((0 (.to a b) :hyp nil)
  (1 (.to (.neg (.neg a)) (.neg (.neg b))) :th-ded (th-mt-step1 0))
  (2 (.to (.to (.neg (.neg a)) (.neg (.neg b))) (.to (.neg b) (.neg a))) :axiom (ii.3))
  (3 (.to (.neg b) (.neg a)) :ir (mp 2 1))))
(:th-ded th-case-split-step1 (.neg c)
 ((0 (.to a c) :hyp nil)
  (1 (.to (.neg a) c) :hyp nil)
  (2 (.neg c) :hyp nil)
  (3 (.to (.to a c) (.to (.neg c) (.neg a))) :th-ded (th-modus-tollens))
  (4 (.to (.neg c) (.neg a)) :ir (mp 3 0))
  (5 (.neg a) :ir (mp 4 2))
  (6 (.to (.to (.neg a) c) (.to (.neg c) (.neg (.neg a)))) :th-ded (th-modus-tollens))
  (7 (.to (.neg c) (.neg (.neg a))) :ir (mp 6 1))
  (8 (.neg (.neg a)) :ir (mp 7 2))
  (9 (.to (.neg (.neg a)) (.to (.neg a) (.neg (.to c c)))) :th-ded (th-ex-falso))
  (10 (.to (.neg a) (.neg (.to c c))) :ir (mp 9 8))
  (11 (.neg (.to c c)) :ir (mp 10 5))))
(:th-ded th-case-split-step2 (.to (.neg a) c)
 ((0 (.to a c) :hyp nil)
  (1 (.to (.neg a) c) :hyp nil)
  (2 (.to (.neg c) (.neg (.to c c))) :th-ded (th-case-split-step1 0 1))
  (3 (.to (.to (.neg c) (.neg (.to c c))) (.to (.to c c) c)) :axiom (ii.3))
  (4 (.to (.to c c) c) :ir (mp 3 2))
  (5 (.to c c) :th-ded (th-identity))
  (6 c :ir (mp 4 5))))
(:th-ded th-case-split (.to a c)
 ((0 (.to a c) :hyp nil)
  (1 (.to (.to (.neg a) c) c) :th-ded (th-case-split-step2 0))))
(:th-ded th-raa-s1 a
 ((0 (.to a b) :hyp nil)
  (1 (.to a (.neg b)) :hyp nil)
  (2 a :hyp nil)
  (3 b :ir (mp 0 2))
  (4 (.neg b) :ir (mp 1 2))
  (5 (.to (.neg b) (.to b (.neg a))) :th-ded (th-ex-falso))
  (6 (.to b (.neg a)) :ir (mp 5 4))
  (7 (.neg a) :ir (mp 6 3))))
(:th-ded th-raa-s3 (.to a (.neg b))
 ((0 (.to a b) :hyp nil)
  (1 (.to a (.neg b)) :hyp nil)
  (2 (.to a (.neg a)) :th-ded (th-raa-s1 0 1))
  (3 (.to (.neg a) (.neg a)) :th-ded (th-identity))
  (4 (.to (.to a (.neg a)) (.to (.to (.neg a) (.neg a)) (.neg a))) :th-ded (th-case-split))
  (5 (.to (.to (.neg a) (.neg a)) (.neg a)) :ir (mp 4 2))
  (6 (.neg a) :ir (mp 5 3))))
(:th-ded th-raa (.to a b)
 ((0 (.to a b) :hyp nil)
  (1 (.to (.to a (.neg b)) (.neg a)) :th-ded (th-raa-s3 0))))
(:th-ded th-mp-flip (.to a c)
 ((0 a :hyp nil)
  (1 (.to a c) :hyp nil)
  (2 c :ir (mp 1 0))))
(:th-ded th-neg-impl (.neg c)
 ((0 a :hyp nil)
  (1 (.neg c) :hyp nil)
  (2 (.to (.to a c) c) :th-ded (th-mp-flip 0))
  (3 (.to (.neg c) (.to (.to a c) (.neg c))) :axiom (ii.1))
  (4 (.to (.to a c) (.neg c)) :ir (mp 3 1))
  (5 (.to (.to (.to a c) c) (.to (.to (.to a c) (.neg c)) (.neg (.to a c)))) :th-ded (th-raa))
  (6 (.to (.to (.to a c) (.neg c)) (.neg (.to a c))) :ir (mp 5 2))
  (7 (.neg (.to a c)) :ir (mp 6 4))))
