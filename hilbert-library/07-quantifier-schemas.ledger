;;; 07-quantifier-schemas.ledger
;;;
;;; Quantifier lemmas stated for predicate schemas: P and Q below stand
;;; for ANY formula with one argument place, "P(x)". Citing a lemma
;;; substitutes a concrete formula for them -- found automatically when P
;;; is applied to distinct variables in the cited formula, or given
;;; explicitly with :inst (see src/k-proof.lisp, "Instantiating a cited
;;; entry"). Every instance is re-verified from scratch, so an instance
;;; that would capture a variable (e.g. P(x) := x = v4 below, where v4 is
;;; a lemma-internal witness) is rejected rather than accepted.
;;;
;;; Variables: v0 = the bound variable, v1/v2 = free instances, v4 = the
;;; EXISTS-ELIM witness, v5 = the uniqueness variable of ∃!. An instance
;;; whose formula mentions v4 or v5 freely must first move them out of
;;; the way with :inst variable replacement, e.g. :inst ((v4 v3)).
;;;
;;; Load order: ... 00-connectives.system, 01, 02, 03, 05, 06, then this.
;;;
;;; Contents
;;;   th-forall-elim       ∀x P(x) → P(t)
;;;   th-exists-intro      P(t) → ∃x P(x)   (in 05-classical-logic.ledger)
;;;   th-forall-mono       ∀x (P(x) → Q(x)) → (∀x P(x) → ∀x Q(x))
;;;   th-exists-mono       ∀x (P(x) → Q(x)) → (∃x P(x) → ∃x Q(x))
;;;   th-exists1-exists    ∃!x P(x) → ∃x P(x)
;;;   th-exists1-unique    ∃!x P(x) → (P(y) → (P(y′) → y = y′))

(:declare-predicate-schema-symbol q 1)   ; p is declared in 05-classical-logic.ledger

;;; --- Instantiation and generalisation -----------------------------------

(:th th-forall-elim
 ((0 (.to (.forall v0 (p v0)) (p v1)) :axiom (III.1 v1))))

;;; --- Monotonicity ----------------------------------------------------------

(:th-ded th-forall-mono-s1 (.forall v0 (p v0))
 ((0 (.forall v0 (.to (p v0) (q v0))) :hyp nil)
  (1 (.forall v0 (p v0)) :hyp nil)
  (2 (.to (.forall v0 (.to (p v0) (q v0))) (.to (p v0) (q v0))) :axiom (III.1 v0))
  (3 (.to (p v0) (q v0)) :ir (mp 2 0))
  (4 (.to (.forall v0 (p v0)) (p v0)) :axiom (III.1 v0))
  (5 (p v0) :ir (mp 4 1))
  (6 (q v0) :ir (mp 3 5))
  (7 (.forall v0 (q v0)) :ir (gen 6 v0))))

(:th-ded th-forall-mono (.forall v0 (.to (p v0) (q v0)))
 ((0 (.forall v0 (.to (p v0) (q v0))) :hyp nil)
  (1 (.to (.forall v0 (p v0)) (.forall v0 (q v0))) :th-ded (th-forall-mono-s1 0))))

(:th-ded th-exists-mono-s1 (.exists v0 (p v0))
 ((0 (.forall v0 (.to (p v0) (q v0))) :hyp nil)
  (1 (.exists v0 (p v0)) :hyp nil)
  (2 (.to (.forall v0 (.to (p v0) (q v0))) (.to (p v4) (q v4))) :axiom (III.1 v4))
  (3 (.to (p v4) (q v4)) :ir (mp 2 0))
  (4 (.to (q v4) (.exists v0 (q v0))) :th (th-exists-intro :inst ((p (v0) (q v0)) (v1 v4))))
  (5 (.to (.to (q v4) (.exists v0 (q v0))) (.to (.to (p v4) (q v4)) (.to (p v4) (.exists v0 (q v0))))) :th-ded (th-hypothetical-syllogism))
  (6 (.to (.to (p v4) (q v4)) (.to (p v4) (.exists v0 (q v0)))) :ir (mp 5 4))
  (7 (.to (p v4) (.exists v0 (q v0))) :ir (mp 6 3))
  (9 (.forall v4 (.to (p v4) (.exists v0 (q v0)))) :ir (gen 7 v4))
  (8 (.exists v0 (q v0)) :th (th-exists-elim 1 9 :inst ((v1 v4))))))

(:th-ded th-exists-mono (.forall v0 (.to (p v0) (q v0)))
 ((0 (.forall v0 (.to (p v0) (q v0))) :hyp nil)
  (1 (.to (.exists v0 (p v0)) (.exists v0 (q v0))) :th-ded (th-exists-mono-s1 0))))

;;; --- Unique existence ------------------------------------------------------
;;; ∃!x P(x) unfolds (EXISTS1-UNFOLD, with u := v5) to
;;; ∃x (P(x) ∧ ∀u (P(u) → u = x)); take its witness as v4 (EXISTS-ELIM).

(:th-ded th-exists1-exists (.exists1 v0 (p v0))
 ((0 (.exists1 v0 (p v0)) :hyp nil)
  (1 (.to (.exists1 v0 (p v0)) (.exists v0 (.and (p v0) (.forall v5 (.to (p v5) (.eq v5 v0)))))) :th-ded (th-identity))
  (2 (.exists v0 (.and (p v0) (.forall v5 (.to (p v5) (.eq v5 v0))))) :ir (mp 1 0))
  (3 (.to (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) (p v4)) :th (th-and-elim-l))
  (4 (.to (p v4) (.exists v0 (p v0))) :th (th-exists-intro :inst ((p (v0) (p v0)) (v1 v4))))
  (5 (.to (.to (p v4) (.exists v0 (p v0))) (.to (.to (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) (p v4)) (.to (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) (.exists v0 (p v0))))) :th-ded (th-hypothetical-syllogism))
  (6 (.to (.to (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) (p v4)) (.to (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) (.exists v0 (p v0)))) :ir (mp 5 4))
  (7 (.to (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) (.exists v0 (p v0))) :ir (mp 6 3))
  (9 (.forall v4 (.to (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) (.exists v0 (p v0)))) :ir (gen 7 v4))
  (8 (.exists v0 (p v0)) :th (th-exists-elim 2 9 :inst ((v1 v4))))))

;;; Uniqueness: from the witness's property, both y and y' equal it.

(:th-ded th-exists1-unique-s1 (p v2)
 ((0 (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) :hyp nil)
  (1 (p v1) :hyp nil)
  (2 (p v2) :hyp nil)
  (3 (.to (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) (.forall v5 (.to (p v5) (.eq v5 v4)))) :th (th-and-elim-r))
  (4 (.forall v5 (.to (p v5) (.eq v5 v4))) :ir (mp 3 0))
  (5 (.to (.forall v5 (.to (p v5) (.eq v5 v4))) (.to (p v1) (.eq v1 v4))) :axiom (III.1 v1))
  (6 (.to (p v1) (.eq v1 v4)) :ir (mp 5 4))
  (7 (.eq v1 v4) :ir (mp 6 1))
  (8 (.to (.forall v5 (.to (p v5) (.eq v5 v4))) (.to (p v2) (.eq v2 v4))) :axiom (III.1 v2))
  (9 (.to (p v2) (.eq v2 v4)) :ir (mp 8 4))
  (10 (.eq v2 v4) :ir (mp 9 2))
  (11 (.to (.eq v2 v4) (.eq v4 v2)) :axiom (IV.3))
  (12 (.eq v4 v2) :ir (mp 11 10))
  (13 (.to (.eq v1 v4) (.to (.eq v4 v2) (.eq v1 v2))) :axiom (IV.4))
  (14 (.to (.eq v4 v2) (.eq v1 v2)) :ir (mp 13 7))
  (15 (.eq v1 v2) :ir (mp 14 12))))

(:th-ded th-exists1-unique-s2 (p v1)
 ((0 (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) :hyp nil)
  (1 (p v1) :hyp nil)
  (2 (.to (p v2) (.eq v1 v2)) :th-ded (th-exists1-unique-s1 0 1))))

(:th-ded th-exists1-unique-s3 (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4))))
 ((0 (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) :hyp nil)
  (1 (.to (p v1) (.to (p v2) (.eq v1 v2))) :th-ded (th-exists1-unique-s2 0))))

(:th-ded th-exists1-unique (.exists1 v0 (p v0))
 ((0 (.exists1 v0 (p v0)) :hyp nil)
  (1 (.to (.exists1 v0 (p v0)) (.exists v0 (.and (p v0) (.forall v5 (.to (p v5) (.eq v5 v0)))))) :th-ded (th-identity))
  (2 (.exists v0 (.and (p v0) (.forall v5 (.to (p v5) (.eq v5 v0))))) :ir (mp 1 0))
  (3 (.to (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) (.to (p v1) (.to (p v2) (.eq v1 v2)))) :th-ded (th-exists1-unique-s3))
  (5 (.forall v4 (.to (.and (p v4) (.forall v5 (.to (p v5) (.eq v5 v4)))) (.to (p v1) (.to (p v2) (.eq v1 v2))))) :ir (gen 3 v4))
  (4 (.to (p v1) (.to (p v2) (.eq v1 v2))) :th (th-exists-elim 2 5 :inst ((v1 v4))))))

;;; --- Descriptions (Principia *14) ---------------------------------------
;;; A description (.iota y P(y)) abbreviates, in its atomic formula Q, the
;;; formula exists b (forall y (P(y) <-> y = b) and Q(b)). These lemmas let
;;; DEFINE-FUNCTION-BY-DESCRIPTION prove a definition's NAME-DEF:
;;;   th-iff-neg, th-iff-imp, th-iff-forall   <-> is preserved by not, ->, forall
;;;   th-desc-proper   exists y P(y), uniqueness |- exists b forall y (P(y) <-> y = b)
;;;   th-desc-atomic   forall y (P(y) <-> y = c) |- exists b (... and Q(b)) <-> Q(c)

(:th-ded th-iff-neg (.iff a b)
 ((0 (.iff a b) :hyp nil)
  (1 (.to (.iff a b) (.to a b)) :th (th-iff-mp))
  (2 (.to a b) :ir (mp 1 0))
  (3 (.to (.iff a b) (.to b a)) :th (th-iff-mpr))
  (4 (.to b a) :ir (mp 3 0))
  (5 (.to (.to a b) (.to (.neg b) (.neg a))) :th (th-contrapositive))
  (6 (.to (.neg b) (.neg a)) :ir (mp 5 2))
  (7 (.to (.to b a) (.to (.neg a) (.neg b))) :th (th-contrapositive))
  (8 (.to (.neg a) (.neg b)) :ir (mp 7 4))
  (9 (.to (.to (.neg a) (.neg b)) (.to (.to (.neg b) (.neg a)) (.iff (.neg a) (.neg b))))
     :th (th-iff-intro))
  (10 (.to (.to (.neg b) (.neg a)) (.iff (.neg a) (.neg b))) :ir (mp 9 8))
  (11 (.iff (.neg a) (.neg b)) :ir (mp 10 6))))
(:th-ded th-iff-imp-s1 b
 ((0 (.to b a) :hyp nil) (1 (.to a c) :hyp nil) (2 (.to c d) :hyp nil) (3 b :hyp nil)
  (4 a :ir (mp 0 3)) (5 c :ir (mp 1 4)) (6 d :ir (mp 2 5))))
(:th-ded th-iff-imp-s2 (.to a c)
 ((0 (.to b a) :hyp nil) (1 (.to a c) :hyp nil) (2 (.to c d) :hyp nil)
  (3 (.to b d) :th-ded (th-iff-imp-s1 0 1 2))))
(:th-ded th-iff-imp (.iff c d)
 ((0 (.iff a b) :hyp nil)
  (1 (.iff c d) :hyp nil)
  (2 (.to (.iff a b) (.to a b)) :th (th-iff-mp))
  (3 (.to a b) :ir (mp 2 0))
  (4 (.to (.iff a b) (.to b a)) :th (th-iff-mpr))
  (5 (.to b a) :ir (mp 4 0))
  (6 (.to (.iff c d) (.to c d)) :th (th-iff-mp))
  (7 (.to c d) :ir (mp 6 1))
  (8 (.to (.iff c d) (.to d c)) :th (th-iff-mpr))
  (9 (.to d c) :ir (mp 8 1))
  (10 (.to (.to a c) (.to b d)) :th-ded (th-iff-imp-s2 5 7))
  (11 (.to (.to b d) (.to a c)) :th-ded (th-iff-imp-s2 3 9))
  (12 (.to (.to (.to a c) (.to b d)) (.to (.to (.to b d) (.to a c)) (.iff (.to a c) (.to b d))))
      :th (th-iff-intro))
  (13 (.to (.to (.to b d) (.to a c)) (.iff (.to a c) (.to b d))) :ir (mp 12 10))
  (14 (.iff (.to a c) (.to b d)) :ir (mp 13 11))))
(:th-ded th-iff-forall-s1 (.forall v0 (p v0))
 ((0 (.forall v0 (.iff (p v0) (q v0))) :hyp nil)
  (1 (.forall v0 (p v0)) :hyp nil)
  (2 (.to (.forall v0 (.iff (p v0) (q v0))) (.iff (p v0) (q v0))) :axiom (iii.1 v0))
  (3 (.iff (p v0) (q v0)) :ir (mp 2 0))
  (4 (.to (.forall v0 (p v0)) (p v0)) :axiom (iii.1 v0))
  (5 (p v0) :ir (mp 4 1))
  (6 (.to (.iff (p v0) (q v0)) (.to (p v0) (q v0))) :th (th-iff-mp))
  (7 (.to (p v0) (q v0)) :ir (mp 6 3))
  (8 (q v0) :ir (mp 7 5))
  (9 (.forall v0 (q v0)) :ir (gen 8 v0))))
(:th-ded th-iff-forall-s2 (.forall v0 (q v0))
 ((0 (.forall v0 (.iff (p v0) (q v0))) :hyp nil)
  (1 (.forall v0 (q v0)) :hyp nil)
  (2 (.to (.forall v0 (.iff (p v0) (q v0))) (.iff (p v0) (q v0))) :axiom (iii.1 v0))
  (3 (.iff (p v0) (q v0)) :ir (mp 2 0))
  (4 (.to (.forall v0 (q v0)) (q v0)) :axiom (iii.1 v0))
  (5 (q v0) :ir (mp 4 1))
  (6 (.to (.iff (p v0) (q v0)) (.to (q v0) (p v0))) :th (th-iff-mpr))
  (7 (.to (q v0) (p v0)) :ir (mp 6 3))
  (8 (p v0) :ir (mp 7 5))
  (9 (.forall v0 (p v0)) :ir (gen 8 v0))))
(:th-ded th-iff-forall (.forall v0 (.iff (p v0) (q v0)))
 ((0 (.forall v0 (.iff (p v0) (q v0))) :hyp nil)
  (1 (.to (.forall v0 (p v0)) (.forall v0 (q v0))) :th-ded (th-iff-forall-s1 0))
  (2 (.to (.forall v0 (q v0)) (.forall v0 (p v0))) :th-ded (th-iff-forall-s2 0))
  (3 (.to (.to (.forall v0 (p v0)) (.forall v0 (q v0)))
          (.to (.to (.forall v0 (q v0)) (.forall v0 (p v0)))
               (.iff (.forall v0 (p v0)) (.forall v0 (q v0)))))
     :th (th-iff-intro))
  (4 (.to (.to (.forall v0 (q v0)) (.forall v0 (p v0))) (.iff (.forall v0 (p v0)) (.forall v0 (q v0))))
     :ir (mp 3 1))
  (5 (.iff (.forall v0 (p v0)) (.forall v0 (q v0))) :ir (mp 4 2))))
(:th th-desc-proper-s0
 ((0 (.forall v0 (.forall v1 (.to (p v0) (.to (p v1) (.eq v0 v1))))) :hyp nil)
  (1 (p v3) :hyp nil)
  (2 (.to (.forall v0 (.forall v1 (.to (p v0) (.to (p v1) (.eq v0 v1)))))
          (.forall v1 (.to (p v0) (.to (p v1) (.eq v0 v1)))))
     :axiom (iii.1 v0))
  (3 (.forall v1 (.to (p v0) (.to (p v1) (.eq v0 v1)))) :ir (mp 2 0))
  (4 (.to (.forall v1 (.to (p v0) (.to (p v1) (.eq v0 v1)))) (.to (p v0) (.to (p v3) (.eq v0 v3))))
     :axiom (iii.1 v3))
  (5 (.to (p v0) (.to (p v3) (.eq v0 v3))) :ir (mp 4 3))
  (6 (.to (.to (p v0) (.to (p v3) (.eq v0 v3))) (.to (p v3) (.to (p v0) (.eq v0 v3))))
     :th-ded (th-permute-antecedents))
  (7 (.to (p v3) (.to (p v0) (.eq v0 v3))) :ir (mp 6 5))
  (8 (.to (p v0) (.eq v0 v3)) :ir (mp 7 1))
  (9 (.to (.eq v3 v0) (.to (p v3) (p v0))) :axiom (iv.2))
  (10 (.to (.eq v0 v3) (.eq v3 v0)) :axiom (iv.3))
  (11 (.to (.to (.eq v3 v0) (.to (p v3) (p v0))) (.to (p v3) (.to (.eq v3 v0) (p v0))))
      :th-ded (th-permute-antecedents))
  (12 (.to (p v3) (.to (.eq v3 v0) (p v0))) :ir (mp 11 9))
  (13 (.to (.eq v3 v0) (p v0)) :ir (mp 12 1))
  (14 (.to (.to (.eq v3 v0) (p v0)) (.to (.to (.eq v0 v3) (.eq v3 v0)) (.to (.eq v0 v3) (p v0))))
      :th-ded (th-hypothetical-syllogism))
  (15 (.to (.to (.eq v0 v3) (.eq v3 v0)) (.to (.eq v0 v3) (p v0))) :ir (mp 14 13))
  (16 (.to (.eq v0 v3) (p v0)) :ir (mp 15 10))
  (17 (.to (.to (p v0) (.eq v0 v3)) (.to (.to (.eq v0 v3) (p v0)) (.iff (p v0) (.eq v0 v3))))
      :th (th-iff-intro))
  (18 (.to (.to (.eq v0 v3) (p v0)) (.iff (p v0) (.eq v0 v3))) :ir (mp 17 8))
  (19 (.iff (p v0) (.eq v0 v3)) :ir (mp 18 16))
  (20 (.forall v0 (.iff (p v0) (.eq v0 v3))) :ir (gen 19 v0))))
(:th-ded th-desc-proper-s1 (p v3)
 ((0 (.forall v0 (.forall v1 (.to (p v0) (.to (p v1) (.eq v0 v1))))) :hyp nil)
  (1 (p v3) :hyp nil)
  (2 (.forall v0 (.iff (p v0) (.eq v0 v3))) :th (th-desc-proper-s0 0 1))
  (3 (.to (.forall v0 (.iff (p v0) (.eq v0 v3))) (.exists v2 (.forall v0 (.iff (p v0) (.eq v0 v2)))))
     :th (th-exists-intro :inst ((p (v2) (.forall v0 (.iff (p v0) (.eq v0 v2)))) (v1 v3))))
  (4 (.exists v2 (.forall v0 (.iff (p v0) (.eq v0 v2)))) :ir (mp 3 2))))
(:th th-desc-proper
 ((0 (.exists v0 (p v0)) :hyp nil)
  (1 (.forall v0 (.forall v1 (.to (p v0) (.to (p v1) (.eq v0 v1))))) :hyp nil)
  (2 (.to (p v3) (.exists v2 (.forall v0 (.iff (p v0) (.eq v0 v2))))) :th-ded (th-desc-proper-s1 1))
  (3 (.forall v3 (.to (p v3) (.exists v2 (.forall v0 (.iff (p v0) (.eq v0 v2)))))) :ir (gen 2 v3))
  (4 (.exists v2 (.forall v0 (.iff (p v0) (.eq v0 v2)))) :th (th-exists-elim 0 3 :inst ((v1 v3))))))
(:th-ded th-desc-atomic-s0 (.and (.forall v0 (.iff (p v0) (.eq v0 v3))) (q v3))
 ((0 (.forall v0 (.iff (p v0) (.eq v0 v1))) :hyp nil)
  (1 (.and (.forall v0 (.iff (p v0) (.eq v0 v3))) (q v3)) :hyp nil)
  (2 (.to (.and (.forall v0 (.iff (p v0) (.eq v0 v3))) (q v3)) (.forall v0 (.iff (p v0) (.eq v0 v3))))
     :th (th-and-elim-l))
  (3 (.forall v0 (.iff (p v0) (.eq v0 v3))) :ir (mp 2 1))
  (4 (.to (.and (.forall v0 (.iff (p v0) (.eq v0 v3))) (q v3)) (q v3)) :th (th-and-elim-r))
  (5 (q v3) :ir (mp 4 1))
  (6 (.to (.forall v0 (.iff (p v0) (.eq v0 v1))) (.iff (p v1) (.eq v1 v1))) :axiom (iii.1 v1))
  (7 (.iff (p v1) (.eq v1 v1)) :ir (mp 6 0))
  (8 (.eq v1 v1) :axiom (iv.1))
  (9 (.to (.iff (p v1) (.eq v1 v1)) (.to (.eq v1 v1) (p v1))) :th (th-iff-mpr))
  (10 (.to (.eq v1 v1) (p v1)) :ir (mp 9 7))
  (11 (p v1) :ir (mp 10 8))
  (12 (.to (.forall v0 (.iff (p v0) (.eq v0 v3))) (.iff (p v1) (.eq v1 v3))) :axiom (iii.1 v1))
  (13 (.iff (p v1) (.eq v1 v3)) :ir (mp 12 3))
  (14 (.to (.iff (p v1) (.eq v1 v3)) (.to (p v1) (.eq v1 v3))) :th (th-iff-mp))
  (15 (.to (p v1) (.eq v1 v3)) :ir (mp 14 13))
  (16 (.eq v1 v3) :ir (mp 15 11))
  (17 (.to (.eq v1 v3) (.eq v3 v1)) :axiom (iv.3))
  (18 (.eq v3 v1) :ir (mp 17 16))
  (19 (.to (.eq v3 v1) (.to (q v3) (q v1))) :axiom (iv.2))
  (20 (.to (q v3) (q v1)) :ir (mp 19 18))
  (21 (q v1) :ir (mp 20 5))))
(:th-ded th-desc-atomic-s1 (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2)))
 ((0 (.forall v0 (.iff (p v0) (.eq v0 v1))) :hyp nil)
  (1 (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))) :hyp nil)
  (2 (.to (.and (.forall v0 (.iff (p v0) (.eq v0 v3))) (q v3)) (q v1)) :th-ded (th-desc-atomic-s0 0))
  (3 (.forall v3 (.to (.and (.forall v0 (.iff (p v0) (.eq v0 v3))) (q v3)) (q v1))) :ir (gen 2 v3))
  (4 (q v1) :th (th-exists-elim 1 3 :inst ((v1 v3))))))
(:th-ded th-desc-atomic-s2 (q v1)
 ((0 (.forall v0 (.iff (p v0) (.eq v0 v1))) :hyp nil)
  (1 (q v1) :hyp nil)
  (2 (.to (.forall v0 (.iff (p v0) (.eq v0 v1)))
          (.to (q v1) (.and (.forall v0 (.iff (p v0) (.eq v0 v1))) (q v1))))
     :th (th-and-intro))
  (3 (.to (q v1) (.and (.forall v0 (.iff (p v0) (.eq v0 v1))) (q v1))) :ir (mp 2 0))
  (4 (.and (.forall v0 (.iff (p v0) (.eq v0 v1))) (q v1)) :ir (mp 3 1))
  (5 (.to (.and (.forall v0 (.iff (p v0) (.eq v0 v1))) (q v1))
          (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))))
     :th (th-exists-intro :inst ((p (v2) (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))) (v1 v1))))
  (6 (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))) :ir (mp 5 4))))
(:th th-desc-atomic
 ((0 (.forall v0 (.iff (p v0) (.eq v0 v1))) :hyp nil)
  (1 (.to (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))) (q v1))
     :th-ded (th-desc-atomic-s1 0))
  (2 (.to (q v1) (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))))
     :th-ded (th-desc-atomic-s2 0))
  (3 (.to (.to (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))) (q v1))
          (.to (.to (q v1) (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))))
               (.iff (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))) (q v1))))
     :th (th-iff-intro))
  (4 (.to (.to (q v1) (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))))
          (.iff (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))) (q v1)))
     :ir (mp 3 1))
  (5 (.iff (.exists v2 (.and (.forall v0 (.iff (p v0) (.eq v0 v2))) (q v2))) (q v1)) :ir (mp 4 2))))
