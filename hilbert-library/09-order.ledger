(:th-ded th-le-total-step (.or (.le v0 v1) (.le v1 v0))
 ((0 (.or (.le v0 v1) (.le v1 v0)) :hyp nil)
  (1 (.to (.le v0 v1) (.or (.le (s v0) v1) (.le v1 (s v0)))) :th (th-le-total-s5))
  (2 (.to (.le v1 v0) (.or (.le (s v0) v1) (.le v1 (s v0)))) :th (th-le-total-s6))
  (3
   (.to (.to (.le v0 v1) (.or (.le (s v0) v1) (.le v1 (s v0))))
    (.to (.to (.le v1 v0) (.or (.le (s v0) v1) (.le v1 (s v0))))
     (.to (.or (.le v0 v1) (.le v1 v0)) (.or (.le (s v0) v1) (.le v1 (s v0))))))
   :th (th-or-elim))
  (4
   (.to (.to (.le v1 v0) (.or (.le (s v0) v1) (.le v1 (s v0))))
    (.to (.or (.le v0 v1) (.le v1 v0)) (.or (.le (s v0) v1) (.le v1 (s v0)))))
   :ir (mp 3 1))
  (5 (.to (.or (.le v0 v1) (.le v1 v0)) (.or (.le (s v0) v1) (.le v1 (s v0)))) :ir (mp 4 2))
  (6 (.or (.le (s v0) v1) (.le v1 (s v0))) :ir (mp 5 0))))

(:th th-le-total-ind
 ((0 (.to (.or (.le v0 v1) (.le v1 v0)) (.or (.le (s v0) v1) (.le v1 (s v0)))) :th
   (th-le-total-step))
  (1 (.forall v0 (.to (.or (.le v0 v1) (.le v1 v0)) (.or (.le (s v0) v1) (.le v1 (s v0))))) :ir
   (gen 0 v0))
  (2
   (.to (.or (.le zero v1) (.le v1 zero))
    (.to (.forall v0 (.to (.or (.le v0 v1) (.le v1 v0)) (.or (.le (s v0) v1) (.le v1 (s v0)))))
     (.forall v0 (.or (.le v0 v1) (.le v1 v0)))))
   :axiom (p3 v0 (.or (.le v0 v1) (.le v1 v0))))
  (3 (.or (.le zero v1) (.le v1 zero)) :th (th-le-total-base))
  (4
   (.to (.forall v0 (.to (.or (.le v0 v1) (.le v1 v0)) (.or (.le (s v0) v1) (.le v1 (s v0)))))
    (.forall v0 (.or (.le v0 v1) (.le v1 v0))))
   :ir (mp 2 3))
  (5 (.forall v0 (.or (.le v0 v1) (.le v1 v0))) :ir (mp 4 1))))

(:th th-le-total
 ((0 (.forall v0 (.or (.le v0 v1) (.le v1 v0))) :th (th-le-total-ind))
  (1 (.to (.forall v0 (.or (.le v0 v1) (.le v1 v0))) (.or (.le v0 v1) (.le v1 v0))) :axiom
   (iii.1 v0))
  (2 (.or (.le v0 v1) (.le v1 v0)) :ir (mp 1 0))
  (3 (.forall v1 (.or (.le v0 v1) (.le v1 v0))) :ir (gen 2 v1))
  (4 (.to (.forall v1 (.or (.le v0 v1) (.le v1 v0))) (.or (.le v0 x2) (.le x2 v0))) :axiom
   (iii.1 x2))
  (5 (.or (.le v0 x2) (.le x2 v0)) :ir (mp 4 3))
  (6 (.forall x2 (.or (.le v0 x2) (.le x2 v0))) :ir (gen 5 x2))
  (7 (.forall v0 (.forall x2 (.or (.le v0 x2) (.le x2 v0)))) :ir (gen 6 v0))
  (8
   (.to (.forall v0 (.forall x2 (.or (.le v0 x2) (.le x2 v0))))
    (.forall x2 (.or (.le x1 x2) (.le x2 x1))))
   :axiom (iii.1 x1))
  (9 (.forall x2 (.or (.le x1 x2) (.le x2 x1))) :ir (mp 8 7))
  (10 (.forall x1 (.forall x2 (.or (.le x1 x2) (.le x2 x1)))) :ir (gen 9 x1))))
